{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.traveltackle.kr/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://api.traveltackle.kr/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://api.traveltackle.kr/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
